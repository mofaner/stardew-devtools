<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>sdv-dev-worker</AssemblyName>
    <RootNamespace>SdvKb</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn);IL3000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\obj\bridge-out\SdvDevBridge.dll" LogicalName="SdvDevBridge.dll" Condition="Exists('..\obj\bridge-out\SdvDevBridge.dll')" />
    <EmbeddedResource Include="..\bridge\manifest.json" LogicalName="SdvDevBridge.manifest.json" />
    <EmbeddedResource Include="..\obj\WikiDocsBundle.zip" LogicalName="WikiDocsBundle.zip" Condition="Exists('..\obj\WikiDocsBundle.zip')" />
    <EmbeddedResource Include="..\obj\MgfxcBundle.zip" LogicalName="MgfxcBundle.zip" Condition="Exists('..\obj\MgfxcBundle.zip')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer" Version="0.4.3" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="8.2.0.7535" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>
</Project>
